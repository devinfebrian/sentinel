# Copy to .env.local and adjust.

# Where the Next server forwards /api/v1/* requests. Server-side only —
# no NEXT_PUBLIC_ prefix, so it never reaches the browser bundle.
# Leave unset to use a backend running locally on port 5000.
BACKEND_URL=https://sentinel-backend-two.vercel.app

# Google sign-in for the login page.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH must be "true" to show the Google button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is the public OAuth client ID (safe for the
# browser bundle — never put the Client Secret here). Both also need the
# backend's GOOGLE_CLIENT_ID set before sign-in will work.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
